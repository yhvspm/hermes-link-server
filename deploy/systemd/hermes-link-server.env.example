# Keep this file on the Server host only, for example /etc/hermes-link-server/server.env.
# Values are intentionally blank; never commit real credentials.

# Hermes Agent remains loopback-only.
HERMES_AGENT_BASE_URL=http://127.0.0.1:8642

# HERMES_LINK_MOBILE_API_TOKEN is generated by
# scripts/bootstrap-hermes-agent-access.sh into internal-agent.env. Do not add
# it here, on the command line, in a QR code, App UI, log or Git.

# Keep pairing state separate from the Agent home so the service can write only
# this directory. Create it with hermes-link ownership and mode 0700.
HERMES_LINK_PAIRING_DB=/var/lib/hermes-link-server/pairing.db

# Read-only Hermes data location used for model/task metadata. The service
# account must have only the minimal read access required by the deployment.
HERMES_HOME=/var/lib/hermes-agent
