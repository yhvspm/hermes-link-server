[Unit]
Description=Hermes Link HTTPS Proxy
After=network-online.target hermes-link-server.service
Wants=network-online.target
Requires=hermes-link-server.service

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/hermes-link-caddy
Environment=XDG_CONFIG_HOME=/var/lib/hermes-link-caddy
ExecStart=/usr/bin/caddy run --environ --config /etc/hermes-link-server/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/hermes-link-server/Caddyfile --adapter caddyfile
TimeoutStopSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/hermes-link-caddy
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
