@@ -581,6 +581,130 @@ def _get_hermes_home() -> Path:
     return _hermes_home or get_hermes_home()
 
 
+def _append_hermes_link_job_result(
+    job: dict,
+    execution_id: str,
+    success: bool,
+    result_text: str = "",
+    error: str | None = None,
+) -> None:
+    """Best-effort, idempotent writeback of a cron result to its Hermes session."""
+    origin = job.get("origin")
+    origin = dict(origin) if isinstance(origin, dict) else {}
+    session_id = str(origin.get("session_id") or "").strip()
+    job_id = str(job.get("id") or "").strip()
+    if not job_id:
+        return
+    if not session_id or not re.fullmatch(r"[A-Za-z0-9._:-]{1,256}", session_id):
+        session_id = f"hermes-link-cron-{job_id}"
+        try:
+            from hermes_state import SessionDB
+
+            home = _get_hermes_home().resolve()
+            db = SessionDB(db_path=home / "state.db")
+            try:
+                db.ensure_session(session_id, source="api_server")
+            finally:
+                db.close()
+
+            origin["session_id"] = session_id
+            from cron.jobs import update_job
+
+            updated = update_job(job_id, {"origin": origin})
+            if isinstance(updated, dict):
+                job.clear()
+                job.update(updated)
+            else:
+                job["origin"] = origin
+        except Exception:
+            logger.warning(
+                "Hermes Link cron session provisioning failed job=%s",
+                job_id,
+                exc_info=True,
+            )
+            return
+
+    execution_id = str(execution_id or "").strip()
+    if not job_id or not execution_id:
+        return
+    user_message_id = f"hermes-link:cron:{job_id}:{execution_id}:request"
+    result_message_id = f"hermes-link:cron:{job_id}:{execution_id}:result"
+    content = str(result_text or "").strip()
+    if not success:
+        content = content or f"定时任务执行失败：{str(error or '未知错误').strip()}"
+    if not content:
+        content = "定时任务完成，但 Agent 没有返回可显示的结果。"
+    try:
+        from hermes_state import SessionDB
+
+        home = _get_hermes_home().resolve()
+        db = SessionDB(db_path=home / "state.db")
+        try:
+            db.ensure_session(session_id, source="api_server")
+            if not db.has_platform_message_id(session_id, user_message_id):
+                prompt = str(job.get("prompt") or "").strip()
+                task_name = str(job.get("name") or job_id).strip()
+                db.append_message(
+                    session_id,
+                    "user",
+                    f"[定时任务：{task_name}]\n{prompt}" if prompt else f"[定时任务：{task_name}]",
+                    platform_message_id=user_message_id,
+                    display_kind="cron_request",
+                )
+            if not db.has_platform_message_id(session_id, result_message_id):
+                db.append_message(
+                    session_id,
+                    "assistant",
+                    content,
+                    platform_message_id=result_message_id,
+                    display_kind="cron_result",
+                    display_metadata={
+                        "job_id": job_id,
+                        "execution_id": execution_id,
+                        "success": bool(success),
+                    },
+                )
+        finally:
+            db.close()
+    except Exception:
+        logger.warning(
+            "Hermes Link cron result writeback failed job=%s session=%s",
+            job_id,
+            session_id,
+            exc_info=True,
+        )
+
+
+def _publish_hermes_link_job_event(
+    job: dict,
+    execution_id: str,
+    success: bool,
+    result_text: str = "",
+    error: str | None = None,
+) -> None:
+    """Best-effort Push event after a cron execution reaches a final state."""
+    _append_hermes_link_job_result(job, execution_id, success, result_text, error)
+    try:
+        from hermes_link_push import publish_job_finished
+
+        home = _get_hermes_home().resolve()
+        profile_id = home.name if home.parent.name == "profiles" else "default"
+        publish_job_finished(
+            profile_id,
+            str(job.get("id") or ""),
+            str(execution_id),
+            success=bool(success),
+            session_id=str((job.get("origin") or {}).get("session_id") or "")
+            if isinstance(job.get("origin"), dict) else "",
+        )
+    except Exception:
+        logger.warning(
+            "Hermes Link Push job event enqueue failed job=%s",
+            job.get("id"),
+            exc_info=True,
+        )
+
