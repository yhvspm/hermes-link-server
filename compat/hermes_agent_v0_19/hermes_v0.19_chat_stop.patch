+    async def _handle_mobile_chat_cancel(self, request: "web.Request") -> "web.Response":
+        """POST /api/mobile/chat/cancel — stop one active mobile chat."""
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        body, body_err = await self._read_json_body(request)
+        if body_err:
+            return body_err
+        session_id = str(body.get("session_id") or "").strip() if isinstance(body, dict) else ""
+        if not session_id or len(session_id) > 256:
+            return web.json_response(
+                _openai_error("session_id is required", code="invalid_session_id"),
+                status=400,
+            )
+        profile_id = _api_request_profile.get() or "default"
+        chat_key = f"{profile_id}\x00{session_id}"
+        chat_state = self._hermes_link_active_chats.get(chat_key)
+        if chat_state is None:
+            return web.json_response({"ok": True, "cancelled": False, "reason": "not_found"})
+        chat_state["stop_requested"] = True
+        agent_ref = chat_state.get("agent_ref")
+        agent = agent_ref[0] if isinstance(agent_ref, list) and agent_ref else None
+        task = chat_state.get("task")
+        if agent is not None:
+            try:
+                agent.interrupt("Stop requested via Hermes Link")
+            except Exception:
+                logger.warning("Hermes Link mobile chat stop interrupt failed", exc_info=True)
+        elif task is not None and not task.done():
+            task.cancel()
+        return web.json_response({"ok": True, "cancelled": True})

