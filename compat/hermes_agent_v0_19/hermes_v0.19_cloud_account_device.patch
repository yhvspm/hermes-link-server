+    async def _handle_mobile_pair_device(self, request: "web.Request") -> "web.Response":
+        """DELETE /api/mobile/pair/device - revoke the current device token."""
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        token = request.headers.get("Authorization", "")[7:].strip()
+        try:
+            from hermes_link_pairing import revoke_device_token
+            revoked = await asyncio.to_thread(revoke_device_token, token)
+        except Exception:
+            logger.exception("Hermes Link device token revoke failed")
+            return web.json_response(
+                _openai_error("Device revoke service is unavailable", code="device_revoke_unavailable"),
+                status=503,
+            )
+        return web.json_response({"ok": True, "revoked": bool(revoked)})
