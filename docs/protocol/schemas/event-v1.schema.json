{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-link:event:v1",
  "title": "Hermes Link Event Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "required": ["event_id", "event_type", "profile_id", "dedupe_key", "session_id"],
      "properties": {
        "event_type": {"const": "chat.completed"},
        "session_id": {"$ref": "#/$defs/identifier"}
      }
    },
    {
      "required": ["event_id", "event_type", "profile_id", "dedupe_key", "job_id"],
      "properties": {
        "event_type": {"enum": ["job.completed", "job.failed"]},
        "job_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"}
      }
    }
  ],
  "required": ["event_id", "event_type", "profile_id", "dedupe_key"],
  "properties": {
    "event_id": {"$ref": "#/$defs/identifier"},
    "event_type": {"enum": ["chat.completed", "job.completed", "job.failed"]},
    "profile_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "dedupe_key": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "number"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    }
  }
}
