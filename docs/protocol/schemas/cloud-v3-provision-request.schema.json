{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-link:cloud:v3:provision-request",
  "title": "Hermes Link Cloud Protocol v3 Attested Provisioning Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation",
    "attestation_signature",
    "platform",
    "bundle_id",
    "app_version"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "attestation": {"$ref": "#/$defs/attestation"},
    "attestation_signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{80,128}$"
    },
    "platform": {"const": "harmonyos"},
    "device_name": {"type": "string", "maxLength": 128},
    "bundle_id": {"type": "string", "minLength": 1, "maxLength": 255},
    "app_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "push_token": {"type": "string", "maxLength": 4096}
  },
  "$defs": {
    "serverId": {
      "type": "string",
      "pattern": "^server_[A-Za-z0-9]{32}$"
    },
    "publicKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "server_id",
        "public_key",
        "installation_id",
        "cloud_url",
        "profiles",
        "issued_at",
        "expires_at",
        "nonce"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "server_id": {"$ref": "#/$defs/serverId"},
        "public_key": {"$ref": "#/$defs/publicKey"},
        "installation_id": {"$ref": "#/$defs/installationId"},
        "cloud_url": {"type": "string", "pattern": "^https://[^?#@]+$"},
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/profileId"}
        },
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 0},
        "nonce": {"type": "string", "pattern": "^att_[A-Za-z0-9_-]{24,128}$"}
      }
    }
  }
}
