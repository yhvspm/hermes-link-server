{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:hermes-link:cloud:v2:event-request",
  "title": "Hermes Link Cloud Protocol v2 Notification Event Request",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "required": ["event_id", "event_type", "profile_id", "dedupe_key", "session_id"],
      "properties": {
        "event_type": {"const": "chat.completed"},
        "session_id": {"$ref": "#/$defs/identifier"}
      }
    },
    {
      "required": ["event_id", "event_type", "profile_id", "dedupe_key", "job_id", "run_id"],
      "properties": {
        "event_type": {"enum": ["job.completed", "job.failed"]},
        "job_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"}
      }
    }
  ],
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "profile_id",
    "dedupe_key",
    "occurred_at",
    "title",
    "body",
    "data",
    "installation_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"$ref": "#/$defs/identifier"},
    "event_type": {"enum": ["chat.completed", "job.completed", "job.failed"]},
    "profile_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "dedupe_key": {"$ref": "#/$defs/identifier"},
    "session_id": {"$ref": "#/$defs/identifier"},
    "job_id": {"$ref": "#/$defs/identifier"},
    "occurred_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "body": {"type": "string", "minLength": 1, "maxLength": 240},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "event_id", "profile_id"],
      "properties": {
        "event_type": {"enum": ["chat.completed", "job.completed", "job.failed"]},
        "event_id": {"$ref": "#/$defs/identifier"},
        "profile_id": {"$ref": "#/$defs/identifier"},
        "session_id": {"$ref": "#/$defs/identifier"},
        "job_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,160}$"
    }
  }
}
